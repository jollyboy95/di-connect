<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- Top Margin -->
    <TextView
        android:id="@+id/aa_textViewTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aa_margin_top"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/aa_editTextTop"
        app:layout_constraintEnd_toStartOf="@+id/aa_editTextTop"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="packed" />

    <EditText
        android:id="@+id/aa_editTextTop"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:inputType="numberSigned"
        android:maxLength="4"
        android:hint="0"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="@android:color/darker_gray"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/aa_textViewTop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/aa_editTextLeft"
        tools:ignore="Autofill" />

    <!-- Left Margin -->
    <TextView
        android:id="@+id/aa_textViewLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aa_margin_left"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/aa_editTextLeft"
        app:layout_constraintEnd_toStartOf="@+id/aa_editTextLeft"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aa_textViewTop"
        app:layout_constraintBottom_toTopOf="@+id/aa_textViewRight" />

    <EditText
        android:id="@+id/aa_editTextLeft"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:inputType="numberSigned"
        android:maxLength="4"
        android:hint="0"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="@android:color/darker_gray"
        android:layout_marginStart="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/aa_textViewLeft"
        app:layout_constraintTop_toBottomOf="@+id/aa_editTextTop"
        app:layout_constraintBottom_toTopOf="@+id/aa_editTextRight"
        tools:ignore="Autofill" />

    <!-- Right Margin -->
    <TextView
        android:id="@+id/aa_textViewRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aa_margin_right"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/aa_editTextRight"
        app:layout_constraintEnd_toStartOf="@+id/aa_editTextRight"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aa_textViewLeft"
        app:layout_constraintBottom_toTopOf="@+id/aa_textViewBottom" />

    <EditText
        android:id="@+id/aa_editTextRight"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:inputType="numberSigned"
        android:maxLength="4"
        android:hint="0"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="@android:color/darker_gray"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/aa_textViewRight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/aa_textViewRight"
        app:layout_constraintTop_toBottomOf="@+id/aa_editTextLeft"
        app:layout_constraintBottom_toTopOf="@+id/aa_editTextBottom"
        tools:ignore="Autofill" />

    <!-- Bottom Margin -->
    <TextView
        android:id="@+id/aa_textViewBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/aa_margin_bottom"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/aa_editTextBottom"
        app:layout_constraintEnd_toStartOf="@+id/aa_editTextBottom"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aa_textViewRight"
        app:layout_constraintBottom_toBottomOf="parent" />

    <EditText
        android:id="@+id/aa_editTextBottom"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:inputType="numberSigned"
        android:maxLength="4"
        android:hint="0"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="@android:color/darker_gray"
        android:layout_marginStart="8dp"
        app:layout_constraintBaseline_toBaselineOf="@+id/aa_textViewBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/aa_textViewBottom"
        tools:ignore="Autofill" />

</androidx.constraintlayout.widget.ConstraintLayout>