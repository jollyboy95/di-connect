<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/aa_da_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="32dp">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/aa_toolbar" android:layout_width="match_parent" android:layout_height="64dp" app:title="@string/aa_da_diagnostics" app:titleTextColor="@color/aa_da_text" app:navigationIcon="@drawable/aa_ic_arrow_back_white" app:navigationIconTint="@color/aa_da_text"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/aa_diagnostic_report_instructions" android:textColor="@color/aa_da_muted" android:textSize="18sp" android:layout_marginVertical="24dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/aa_save_diagnostic_report" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/aa_save_diagnostic_report" android:textAllCaps="false" android:textSize="18sp" app:icon="@drawable/aa_ic_da_diagnostics" app:cornerRadius="18dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/aa_choose_diagnostic_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/aa_choose_report_location" android:textAllCaps="false" android:textSize="18sp" android:layout_marginTop="12dp" app:cornerRadius="18dp"/>
    </LinearLayout>
</ScrollView>
